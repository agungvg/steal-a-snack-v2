-- ---------------------------------------------------------------- Inst
local Inst = {}
local methods = {}

function methods:FindFirstChild(name)
	for _, child in ipairs(self._children) do
		if child.Name == name then
			return child
		end
	end
	return nil
end

function methods:GetChildren()
	local out = {}
	for _, child in ipairs(self._children) do
		table.insert(out, child)
	end
	return out
end

function methods:GetDescendants()
	local out = {}
	local function walk(node)
		for _, child in ipairs(node._children) do
			table.insert(out, child)
			walk(child)
		end
	end
	walk(self)
	return out
end

function methods:Destroy()
	self._destroyed = true
	self.Parent = nil
end

function methods:PivotTo(cf)
	self._pivot = cf
	if self.PrimaryPart then
		self.PrimaryPart.CFrm = cf
	end
end

function methods:GetPivot()
	if self._pivot then
		return self._pivot
	end
	if self.PrimaryPart then
		return CFrm.new(self.PrimaryPart.Position)
	end
	return CFrm.new(0, 0, 0)
end

function methods:IsA(className)
	if className == "BasePart" then
		return self.ClassName == "Part"
	end
	return self.ClassName == className
end

function methods:SetAttribute(key, value)
	self._attrs[key] = value
end

function methods:GetAttribute(key)
	return self._attrs[key]
end

local instanceMt = {}
instanceMt.__index = function(t, k)
	if k == "Parent" then
		return rawget(t, "_parent")
	end
	local v = rawget(t, k)
	if v ~= nil then
		return v
	end
	return methods[k]
end
instanceMt.__newindex = function(t, k, v)
	if k == "Parent" then
		local old = rawget(t, "_parent")
		if old then
			for i, child in ipairs(old._children) do
				if child == t then
					table.remove(old._children, i)
					break
				end
			end
		end
		rawset(t, "_parent", v)
		if v then
			table.insert(v._children, t)
		end
	else
		rawset(t, k, v)
	end
end

function Inst.new(className, parent)
	local obj = {
		ClassName = className,
		Name = className,
		_children = {},
		_attrs = {},
		_destroyed = false,
	}
	if className == "ClickDetector" then
		obj.MouseClick = {
			Connect = function(_self, cb)
				obj._clickCb = cb
				return { Disconnect = function() end }
			end,
		}
	end
	setmetatable(obj, instanceMt)
	if parent then
		obj.Parent = parent
	end
	return obj
end

