-- ------------------------------------------------------------------ public API
function CharacterFactory.buildSnack(
	def: SnackDef,
	variantName: string,
	groundPos: Vector3,
	headingRad: number,
	parent: Instance
): Model
	local model = Instance.new("Model")
	model.Name = def.displayName .. "_" .. variantName

	-- Root: invisible anchor plate; bottom sits exactly on the ground,
	-- centre at the ground point (the model's PrimaryPart).
	local root = Instance.new("Part")
	root.Name = "Root"
	root.Size = Vector3.new(0.5, 0.05, 0.5)
	root.Color = Color3.fromRGB(0, 0, 0)
	root.Transparency = 1
	root.Anchored = true
	root.CanCollide = false
	root.Material = Enum.Material.SmoothPlastic
	root.Position = groundPos + Vector3.new(0, 0.025, 0)
	root.CFrame = CFrame.new(groundPos) * CFrame.Angles(0, headingRad, 0)
	root.Parent = model
	model.PrimaryPart = root

	local ctx = makeCtx(model, def, variantName, groundPos, headingRad)
	local build = FOOD[def.key]
	assert(build ~= nil, "CharacterFactory.buildSnack: no food builder for " .. def.key)
	build(ctx)

	-- Rarity disc under the feet (Neon, 0.35 transparency).
	local disc = Instance.new("Part")
	disc.Name = "Disc"
	disc.Size = Vector3.new(def.size * 1.25, 0.12, def.size * 1.25)
	disc.Color = ctx.rarity
	disc.Transparency = 0.35
	disc.Anchored = true
	disc.CanCollide = false
	disc.Material = Enum.Material.Neon
	disc.Position = groundPos + Vector3.new(0, 0.07, 0)
	disc.Parent = model

	-- Floating label above the snack.
	local body = model:FindFirstChild("Body")
	local billboard = Instance.new("BillboardGui")
	billboard.Name = "Caption"
	billboard.Adornee = body
	billboard.Size = UDim2.new(0, 150, 0, 56)
	billboard.StudsOffsetWorldSpace = Vector3.new(0, def.size * 0.9, 0)
	billboard.AlwaysOnTop = true
	billboard.Parent = model

	local nameLabel = Instance.new("TextLabel")
	nameLabel.Name = "NameLine"
	nameLabel.Size = UDim2.new(1, 0, 0.5, 0)
	nameLabel.BackgroundTransparency = 1
	nameLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
	nameLabel.TextStrokeTransparency = 0.2
	nameLabel.TextScaled = true
	nameLabel.Font = Enum.Font.GothamBold
	nameLabel.Text = def.displayName
	nameLabel.Parent = billboard

	local infoLabel = Instance.new("TextLabel")
	infoLabel.Name = "InfoLine"
	infoLabel.Size = UDim2.new(1, 0, 0.5, 0)
	infoLabel.Position = UDim2.new(0, 0, 0.5, 0)
	infoLabel.BackgroundTransparency = 1
	infoLabel.TextColor3 = Color3.fromRGB(255, 230, 120)
	infoLabel.TextStrokeTransparency = 0.2
	infoLabel.TextScaled = true
	infoLabel.Font = Enum.Font.GothamBold
	infoLabel.Text = "$" .. tostring(def.price) .. "  •  $" .. tostring(def.rate) .. "/s"
	infoLabel.Parent = billboard

	-- Tags other systems read back (no extra parts needed).
	model:SetAttribute("SnackKey", def.key)
	model:SetAttribute("Variant", variantName)
	model:SetAttribute("Rarity", def.rarity)

	model.Parent = parent
	return model
end

function CharacterFactory.attachClick(model: Model, reach: number, handler: (Player) -> ()): ClickDetector
	local root = model.PrimaryPart
	assert(root ~= nil, "CharacterFactory.attachClick: model has no PrimaryPart")
	-- Parent the detector to the visible food body ("Body", the food's main
	-- mass), NOT to the invisible Root plate: a ClickDetector only fires
	-- when its own parent part is clicked, and the Root is a tiny invisible
	-- 0.5x0.05x0.5 plate at the ground — so clicking the snack itself did
	-- nothing and buying felt broken.
	local target = model:FindFirstChild("Body")
	if not target or not target:IsA("BasePart") then
		target = root
	end
	local detector = Instance.new("ClickDetector")
	detector.MaxActivationDistance = reach
	detector.Parent = target
	detector.MouseClick:Connect(function(player: Player)
		handler(player)
	end)
	return detector
end

function CharacterFactory.setCaption(model: Model, line1: string, line2: string): ()
	local board = model:FindFirstChild("Caption")
	if board and board:IsA("BillboardGui") then
		local nameLine = board:FindFirstChild("NameLine")
		local infoLine = board:FindFirstChild("InfoLine")
		if nameLine and nameLine:IsA("TextLabel") then
			nameLine.Text = line1
		end
		if infoLine and infoLine:IsA("TextLabel") then
			infoLine.Text = line2
		end
	end
end

function CharacterFactory.countParts(model: Model): number
	local count = 0
	for _, descendant in ipairs(model:GetDescendants()) do
		if descendant:IsA("BasePart") then
			count += 1
		end
	end
	return count
end


--!strict
-- Steal a Snack v2 — Weather: rotating sky conditions.
-- Five weathers rotate on a 150-180s cycle with a 4s fade. `settingsFor`
-- is pure data (headless-testable); `applyTo` pushes one weather onto a
-- Lighting instance; `begin` runs the rotation loop on the server.
--
-- PUBLIC API:
--   settingsFor(name) -> WeatherSettings  (pure table, no instances)
--   applyTo(lighting, name) -> ()         (sets Lighting + Atmosphere)
--   current() -> string                   (name of the active weather)
--   begin(lighting, onChange, minStretch?, maxStretch?, fadeSeconds?) -> ()
--       starts the rotation loop; onChange(name) fires per change.
--       Stretch/fade default to 150s / 180s / 4s; init passes Config values.

local Weather = {}

local WEATHER_NAMES = { "Sunny", "Rain", "Storm", "Fog", "Snow" } :: { string }

export type WeatherSettings = {
	brightness: number,
	clockTime: number,
	ambient: { number },
	outdoorAmbient: { number },
	fogEnd: number,
	atmosphereDensity: number,
	atmosphereOffset: number,
}

Weather.SETTINGS = {
	Sunny = {
		brightness = 2.6,
		clockTime = 13.5,
		ambient = { 150, 140, 128 },
		outdoorAmbient = { 158, 173, 199 },
		fogEnd = 1200,
		atmosphereDensity = 0.28,
		atmosphereOffset = 0.25,
	},
	Rain = {
		brightness = 1.6,
		clockTime = 12.5,
		ambient = { 100, 105, 115 },
		outdoorAmbient = { 115, 122, 138 },
		fogEnd = 500,
		atmosphereDensity = 0.4,
		atmosphereOffset = 0.2,
	},
	Storm = {
		brightness = 1.1,
		clockTime = 17.5,
		ambient = { 70, 72, 88 },
		outdoorAmbient = { 82, 84, 104 },
		fogEnd = 260,
		atmosphereDensity = 0.55,
		atmosphereOffset = 0.1,
	},
	Fog = {
		brightness = 1.35,
		clockTime = 10.5,
		ambient = { 135, 134, 138 },
		outdoorAmbient = { 146, 146, 150 },
		fogEnd = 160,
		atmosphereDensity = 0.65,
		atmosphereOffset = 0.4,
	},
	Snow = {
		brightness = 2.0,
		clockTime = 12,
		ambient = { 155, 160, 175 },
		outdoorAmbient = { 175, 180, 195 },
		fogEnd = 450,
		atmosphereDensity = 0.35,
		atmosphereOffset = 0.3,
	},
} :: { [string]: WeatherSettings }

local currentName = "Sunny"
local currentIndex = 1

function Weather.settingsFor(name: string): WeatherSettings
	local found = Weather.SETTINGS[name]
	if found then
		return found
	end
	return Weather.SETTINGS.Sunny
end

function Weather.applyTo(lighting: Lighting, name: string): ()
	local s = Weather.settingsFor(name)
	lighting.Brightness = s.brightness
	lighting.ClockTime = s.clockTime
	lighting.Ambient = Color3.fromRGB(s.ambient[1], s.ambient[2], s.ambient[3])
	lighting.OutdoorAmbient = Color3.fromRGB(s.outdoorAmbient[1], s.outdoorAmbient[2], s.outdoorAmbient[3])
	lighting.FogEnd = s.fogEnd
	local atmosphere = lighting:FindFirstChild("Atmosphere")
	if atmosphere and atmosphere:IsA("Atmosphere") then
		atmosphere.Density = s.atmosphereDensity
		atmosphere.Offset = s.atmosphereOffset
	end
	currentName = name
end

function Weather.current(): string
	return currentName
end

function Weather.begin(
	lighting: Lighting,
	onChange: (string) -> (),
	minStretch: number?,
	maxStretch: number?,
	fadeSeconds: number?
): ()
	local minS = minStretch or 150
	local maxS = maxStretch or 180
	local fadeS = fadeSeconds or 4
	Weather.applyTo(lighting, "Sunny")
	task.spawn(function()
		while true do
			local stretch = minS + math.random() * (maxS - minS)
			task.wait(stretch)
			currentIndex = currentIndex % #WEATHER_NAMES + 1
			local nextName = WEATHER_NAMES[currentIndex]
			-- Fade: step the lighting in small increments.
			local from = Weather.settingsFor(currentName)
			local to = Weather.settingsFor(nextName)
			local steps = 20
			for step = 1, steps do
				local t = step / steps
				lighting.Brightness = from.brightness + (to.brightness - from.brightness) * t
				lighting.FogEnd = from.fogEnd + (to.fogEnd - from.fogEnd) * t
				task.wait(fadeS / steps)
			end
			Weather.applyTo(lighting, nextName)
			onChange(nextName)
		end
	end)
end


--!strict
-- Steal a Snack v2 — Bases: base claiming, slot geometry, snack placement,
-- AND the realistic base environment (fresh build for the v2 environment pass).
--
-- *** API CONTRACT — UNCHANGED ***
-- The 11 placement functions below are byte-for-byte the v2 behaviour from
-- API.md / src/server/Bases.luau. Nothing about claiming, slots or records
-- changed: same slot grid (3 cols x 2 rows, offsets (-6|0|6, 0, -3.5|+3.5)),
-- same 8 bases at Config.BASE_CENTERS, same SlotRecord shape.
--   claim(player) -> number            base index 1..8, or 0 when full
--   drop(player) -> ()                 release the player's base
--   indexOf(player) -> number          0 when the player has no base
--   platformCenter(i) -> Vector3       world centre of base i (top y = 1)
--   slotWorldPos(i, slot) -> Vector3   ground point of a slot on base i
--   firstEmpty(i) -> number?           first free slot, nil when full
--   place(i, slot, record) -> ()       record a snack on a slot
--   remove(i, slot) -> SlotRecord?     take a snack off a slot (no destroy)
--   peek(i, slot) -> SlotRecord?       read one slot without removing it
--   list(i) -> {SlotRecord}            every snack on base i
--   clearAll(i) -> ()                  empty a base (destroys the models)
--   count(i) -> number                 snacks currently on base i
--
-- *** NEW, ADDITIVE ONLY ***
--   buildBase(index, parent) -> Model  build ONE base's realistic dressing
--   build(parent) -> Folder            build all 8 bases + plaza dressing
-- `build` is never called by the existing server init; the parent wires it
-- in (once, at boot). It is idempotent: re-running it destroys the previous
-- "BasesEnv" folder first. No game logic lives here — only geometry.
--
-- ENVIRONMENT DESIGN (roblox-realism skill; Genshin town-square reference):
-- Value + roughness first, colour second, texture third. Every surface uses
-- a library material — no default grey, no SmoothPlastic-everywhere.
--   Base floor   WoodPlanks, warm 120-160, ±3-6% value jitter per board
--   Foundation   Cobblestone plinth (stone base the planks sit on)
--   Back wall    Plaster, warm neutral 170-210, never pure white (cap 235)
--   Pilasters    Cobblestone; trim / plate carry the base's own colour
--   Flags/banner Fabric in the base colour + cream
--   Stall        Wood counter (top one tone lighter than the frame),
--                Fabric red/white striped awning, framed Glass window +
--                Glass jars, Cardboard boxes, Foil snack bundles
--   Lamp         warm 2700 K Neon bulb (255,167,87) + PointLight, range 14
--   Wear         geometry strips (dirt at floor line, scuffs on the front
--                edge, streaks under the stall window) — geometry, not
--                decals, because this project has no licensed grime texture
--                asset; a fake rbxassetid would render as a broken image.
--   Kerbs/seams  Concrete kerb ring where grass meets stone; Cobblestone
--                path panels (jittered stone tones) from each base to the
--                belt; gold Neon wedge chevrons point toward the belt.
--   Greenery     layered trees (trunk + 3 canopy volumes, varied greens),
--                bushes, flower beds with pink/yellow/purple accents.
--   Water        granite fountain (north gap) + pebble-rim pond (south gap).
-- Layout is UNTOUCHED: bases stay at Config.BASE_CENTERS, platform
-- footprint stays 20 x 14 with its top at y = 1, the belt is not moved.
-- The stall sits just BEHIND each base's back wall (outside the platform)
-- so it can never clip a snack standing on a slot (snacks are up to 6
-- studs wide). Slots, clicks and steal reach are unaffected.
--
-- BACKGROUND + LIGHTS (Lyso order 2026-11-18: background must be nice WITH
-- LIGHTS, bases must be COOL, not standard):
--   Plaza lamps  6 tall lamp posts framing the belt (3 per side) with a
--                warm Neon bulb + PointLight each (range 18, shadowless).
--   String lights 4 catenary spans between the lamp posts, warm/gold +
--                pink/cyan Neon bulbs with a thin wire, sagging mid-span.
--   Neon identity every base glows in its accent colour: a Neon crown
--                strip on the back wall, Neon caps on the pilasters, a
--                Neon front-edge strip, and a glowing entrance arch
--                (posts + Neon top bar + orbs) framing the front.
--   Floor runner an accent-colour carpet with gold Neon edges down the
--                middle of each platform (flat, 0.06 proud — slots sit
--                on it, geometry unchanged).
--   Ground life  flower beds along the belt, boulder clusters on the
--                outer grass, cobble paths belt -> fountain and belt ->
--                pond, and 4 more layered trees at the far corners
--                (the plain ball-on-stick trees were removed from
--                default.project.json).
-- Light budget: 6 plaza + 8 stall + 1 fountain = 15 PointLights total,
-- all shadowless. Neon/string bulbs are emissive only (no light cost).
--
-- SlotRecord = { snackKey: string, variant: string, rate: number,
--                mult: number, model: Model }


local Bases = {}

export type SlotRecord = {
	snackKey: string,
	variant: string,
	rate: number,
	mult: number,
	model: Model,
}

local claims: { [Player]: number } = {}
local taken: { [number]: boolean } = {}
local slots: { [number]: { [number]: SlotRecord } } = {}

-- Slot grid offsets relative to the platform centre (3 cols x 2 rows).
local SLOT_OFFSETS = {
	Vector3.new(-6, 0, -3.5),
	Vector3.new(0, 0, -3.5),
	Vector3.new(6, 0, -3.5),
	Vector3.new(-6, 0, 3.5),
	Vector3.new(0, 0, 3.5),
	Vector3.new(6, 0, 3.5),
}

function Bases.claim(player: Player): number
	local existing = claims[player]
	if existing then
		return existing
	end
	for i = 1, Config.MAX_BASES do
		if not taken[i] then
			taken[i] = true
			claims[player] = i
			slots[i] = {}
			return i
		end
	end
	return 0
end

function Bases.drop(player: Player): ()
	local index = claims[player]
	if index then
		Bases.clearAll(index)
		taken[index] = nil
		slots[index] = nil
		claims[player] = nil
	end
end

function Bases.indexOf(player: Player): number
	return claims[player] or 0
end

function Bases.platformCenter(index: number): Vector3
	return Config.BASE_CENTERS[index]
end

function Bases.slotWorldPos(index: number, slot: number): Vector3
	return Config.BASE_CENTERS[index] + SLOT_OFFSETS[slot]
end

function Bases.firstEmpty(index: number): number?
	local held = slots[index]
	if not held then
		return nil
	end
	for slot = 1, Config.MAX_SLOTS_PER_BASE do
		if held[slot] == nil then
			return slot
		end
	end
	return nil
end

function Bases.place(index: number, slot: number, record: SlotRecord): ()
	slots[index][slot] = record
end

function Bases.remove(index: number, slot: number): SlotRecord?
	local held = slots[index]
	if not held then
		return nil
	end
	local record = held[slot]
	held[slot] = nil
	return record
end

-- Read one slot without removing it (used by saves + the HUD sync).
function Bases.peek(index: number, slot: number): SlotRecord?
	local held = slots[index]
	if not held then
		return nil
	end
	return held[slot]
end

function Bases.list(index: number): { SlotRecord }
	local out = {}
	local held = slots[index]
	if held then
		for _, record in pairs(held) do
			table.insert(out, record)
		end
	end
	return out
end

function Bases.count(index: number): number
	return #Bases.list(index)
end

function Bases.clearAll(index: number): ()
	local held = slots[index]
	if held then
		for _, record in pairs(held) do
			if record.model then
				record.model:Destroy()
			end
		end
		slots[index] = {}
	end
end

