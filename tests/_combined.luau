		part(parent, "LilyFlower" .. i, Enum.Material.SmoothPlastic,
			rgb(FLOWER_COLORS[i]), Vector3.new(0.3, 0.3, 0.3),
			Vector3.new(px + math.cos(a) * 2.2, 0.6, pz + math.sin(a) * 2.2),
			Enum.PartType.Ball)
